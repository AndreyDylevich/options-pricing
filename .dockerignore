# Что не попадает в образ.

# .env с настоящим паролем к базе в образ класть нельзя: образ можно
# выложить или передать, а пароль внутри останется. Настройки для
# контейнера задаются в compose.yml.
.env

# Виртуальное окружение хоста непереносимо: внутри пути и бинарники
# macOS, а образ собирается под Linux.
.venv/

.git/
__pycache__/
*.py[cod]
.pytest_cache/
.DS_Store
.idea/
