# Скопировать в .env и подставить свои значения.
# .env в git не попадает (см. .gitignore).

DATABASE_URL=postgresql+asyncpg://postgres:ПАРОЛЬ@localhost:5432/pricing

# Безрисковая ставка по умолчанию, доля единицы.
# Подставляется в форму, если не удалось получить ^IRX.
DEFAULT_RISK_FREE_RATE=0.042

# Сколько минут считать закэшированные рыночные данные свежими.
MARKET_CACHE_TTL_MINUTES=15

# Порог ликвидности: минимум страйков с котировками у бумаги.
MIN_QUOTED_STRIKES=20

# Ограничение частоты запросов с одного адреса.
# Формат slowapi: "120/minute", "5/second", "1000/hour".
RATE_LIMIT=120/minute

# Отдельный лимит на расчётные эндпоинты — они дороже всех остальных.
PRICING_RATE_LIMIT=30/minute

# Сколько расчётов выполнять одновременно. Держит потолок памяти:
# тяжёлый Монте-Карло занимает до 200 МБ на запрос.
MAX_CONCURRENT_PRICING=4

# Токен для эндпоинтов, меняющих состояние (POST /api/instruments/sync).
# Если не задан, генерируется случайный при каждом запуске сервера —
# страница получает его сама, а вот скриптам нужен постоянный.
# Только латиница и цифры: заголовки HTTP кириллицу не переносят.
# ADMIN_TOKEN=

# Сколько дней хранить историю расчётов в таблице calculations.
# Записи старше удаляются при старте сервера и раз в час.
CALCULATION_RETENTION_DAYS=3
